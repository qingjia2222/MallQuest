# ===== 服务配置 =====
MALL_SERVER_HOST=0.0.0.0
MALL_SERVER_PORT=8200
MALL_DB=sqlite:///./data/mall.db

# ===== 大模型（OpenAI 兼容端点，如 DeepSeek / 通义 Qwen）=====
# 无 key 时自动回退到离线 scripted agent，保证断网可演示
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=25

# ===== 微信小程序 =====
WX_APPID=
WX_SECRET=

# ===== Web 登录（演示用，账号密码）=====
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=

# ===== 默认商场 =====
DEFAULT_MALL_ID=mall-main
