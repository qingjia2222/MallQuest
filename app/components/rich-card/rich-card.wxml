<!-- 店铺卡 -->
<view wx:if="{{kind === 'store'}}" class="rc rc-store" bindtap="onTap">
  <view class="rc-head">
    <view class="rc-avatar rc-avatar-{{card.data.floor}}">🏬</view>
    <view class="rc-main">
      <text class="rc-name">{{card.data.name}}</text>
      <text class="rc-sub">{{card.data.category}} · {{card.data.floor}}F · 评分{{card.data.rating}}</text>
    </view>
    <view class="rc-wait {{card.data.waiting > 10 ? 'busy' : ''}}">{{card.data.waiting}} 桌</view>
  </view>
</view>

<!-- 停车卡 -->
<view wx:elif="{{kind === 'parking'}}" class="rc rc-parking" bindtap="onTap">
  <view class="rc-head">
    <text class="rc-name">实时停车位</text>
    <text class="rc-sub">更新于 {{card.data.updatedAt}}</text>
  </view>
  <view class="parking-row">
    <view class="parking-one">
      <text class="pk-num">{{card.data.free}}</text>
      <text class="pk-label">总空位</text>
    </view>
    <view class="parking-bar"><view class="pk-bar-inner" style="width:{{card.data.ratio}}%"></view></view>
  </view>
  <view class="parking-areas">
    <view wx:for="{{card.data.areas}}" wx:key="area" class="pk-area">
      <text class="pk-area-name">{{item.area}}</text>
      <text class="pk-area-free">{{item.free}} 空</text>
    </view>
  </view>
</view>

<!-- 优惠券卡 -->
<view wx:elif="{{kind === 'coupon'}}" class="rc rc-coupon" bindtap="onTap">
  <view class="cp-left">
    <text class="cp-tit">{{card.data.title}}</text>
    <text class="cp-scope">{{card.data.scope}}</text>
  </view>
  <view class="cp-right">
    <text class="cp-expire">{{card.data.expire}}</text>
    <view class="cp-btn">领取</view>
  </view>
</view>

<!-- 排队店铺列表 -->
<view wx:elif="{{kind === 'queue'}}" class="rc rc-list" bindtap="onTap">
  <view class="list-title">当前排队店铺</view>
  <view wx:if="{{!card.data.length}}" class="list-empty">当前没有需要排队的店铺</view>
  <view wx:for="{{card.data}}" wx:key="id" class="list-row">
    <view class="list-rank">{{index + 1}}</view>
    <view class="list-main"><text class="rc-name">{{item.name}}</text><text class="rc-sub">{{item.floor}}F · {{item.category}} · 可用座位 {{item.seats_available}}</text></view>
    <view class="queue-min">{{item.queue_minutes}} 分钟</view>
  </view>
</view>

<!-- 店铺搜索列表 -->
<view wx:elif="{{kind === 'stores'}}" class="rc rc-list" bindtap="onTap">
  <view class="list-title">店铺搜索结果</view>
  <view wx:if="{{!card.data.length}}" class="list-empty">没有找到匹配店铺，试试输入店名或类别</view>
  <view wx:for="{{card.data}}" wx:key="id" class="list-row">
    <view class="list-symbol">店</view>
    <view class="list-main"><text class="rc-name">{{item.name}}</text><text class="rc-sub">{{item.floor}}F · {{item.category}}</text></view>
  </view>
</view>

<!-- 今日特惠列表 -->
<view wx:elif="{{kind === 'deals'}}" class="rc rc-list">
  <view class="list-title">今日特惠</view>
  <view wx:for="{{card.data}}" wx:key="id" class="list-row">
    <view class="list-symbol deal-symbol">惠</view>
    <view class="list-main"><text class="rc-name">{{item.title}}</text><text class="rc-sub">剩余 {{item.stock}} 份</text></view>
    <view class="deal-price">¥{{item.price}}</view>
  </view>
</view>

<!-- 会员信息 -->
<view wx:elif="{{kind === 'member'}}" class="rc member-card">
  <view><text class="rc-sub">当前积分</text><view class="member-points">{{card.data.points}}</view></view>
  <view class="member-meta"><text>{{card.data.level}}</text><text>有效期至 {{card.data.expires_on}}</text></view>
</view>

<!-- 知识库回答 -->
<view wx:elif="{{kind === 'rag'}}" class="rc rc-rag">
  <view class="list-title">积分规则</view>
  <text class="rag-answer">{{card.data.answer}}</text>
</view>

<!-- 通用文字卡 -->
<view wx:else class="rc rc-generic" bindtap="onTap">
  <text class="rc-name">{{card.title}}</text>
  <text class="rc-sub">{{card.subtitle}}</text>
</view>
