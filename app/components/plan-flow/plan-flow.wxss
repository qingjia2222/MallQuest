.pf { display: flex; align-items: flex-start; padding: 8rpx 0; }
.pf-item { display: flex; flex-direction: column; align-items: center; }
.pf-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #f3f4f6; color: #9CA3AF;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
  transition: all 0.3s;
}
.pf-item.done .pf-dot { background: linear-gradient(135deg, var(--primary), var(--cyan)); color: #fff; }
.pf-item.cur .pf-dot { box-shadow: 0 0 0 8rpx rgba(124, 58, 237, 0.15); background: var(--primary); color: #fff; }
.pf-label { font-size: 22rpx; color: #9CA3AF; margin-top: 8rpx; white-space: nowrap; }
.pf-item.done .pf-label, .pf-item.cur .pf-label { color: var(--primary-dark); font-weight: 600; }
.pf-line { flex: 1; height: 4rpx; background: #f3f4f6; margin-top: 26rpx; border-radius: 4rpx; }
.pf-line.done { background: var(--primary); }
