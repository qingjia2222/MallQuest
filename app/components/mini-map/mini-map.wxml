<view class="mm">
  <canvas id="mall3d" type="webgl" class="mm-webgl"
          catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"></canvas>
  <view class="mm-label-layer">
    <view wx:for="{{labels}}" wx:key="key" class="mm-label {{item.facility ? 'facility' : ''}}" style="left:{{item.x}}px;top:{{item.y}}px">{{item.name}}</view>
  </view>

  <view class="mm-floors">
    <view class="mm-floor {{floor === 0 ? 'active' : ''}}" data-f="0" bindtap="setFloor">全部</view>
    <view class="mm-floor {{floor === 2 ? 'active' : ''}}" data-f="2" bindtap="setFloor">2F</view>
    <view class="mm-floor {{floor === 1 ? 'active' : ''}}" data-f="1" bindtap="setFloor">1F</view>
  </view>
  <view class="mm-mode">{{webglReady ? '3D' : '2.5D'}}</view>
  <view wx:if="{{route.length || routeNodes.length}}" class="mm-replay" bindtap="replayRoute">重播路线</view>

  <view wx:if="{{webglFailed}}" class="mm-fallback">
    <view class="mm-grid"></view>
    <view wx:for="{{stores}}" wx:key="id"
          class="mm-store {{item.id === activeId ? 'active' : ''}} {{floor && item.floor !== floor ? 'dim' : ''}}"
          style="left:{{item.pos_x}}%;top:{{item.pos_y}}%"
          data-store="{{item}}" bindtap="onStoreTap">
      <text>{{item.category === '咖啡' ? '☕' : item.category === '影院' ? '🎬' : item.category === '甜品' ? '🍰' : '🏬'}}</text>
    </view>
  </view>
  <view class="mm-legend">{{webglReady ? '上下左右拖动查看 · 点击店铺 · 红点为实时路线' : '当前设备使用平面兼容模式'}}</view>
</view>
