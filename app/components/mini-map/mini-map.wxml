<view class="mm">
  <!-- 楼层切换 -->
  <view class="mm-floors">
    <view wx:for="{{[1,2,3,4]}}" wx:key="*this"
          class="mm-floor {{floor === item ? 'active' : ''}}"
          data-f="{{item}}" bindtap="setFloor">{{item}}F</view>
  </view>

  <!-- 地图画布 -->
  <view class="mm-canvas">
    <!-- 网格 -->
    <view class="mm-grid"></view>
    <!-- 路线连线（L 型段） -->
    <view wx:for="{{segs}}" wx:key="index" class="mm-seg"
          style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.w}}%;height:{{item.h}}%"></view>
    <!-- 店铺节点 -->
    <view wx:for="{{stores}}" wx:key="id"
          class="mm-store {{item.id === activeId ? 'active' : ''}} {{item.floor !== floor ? 'dim' : ''}}"
          style="left:{{item.pos_x}}%;top:{{item.pos_y}}%"
          data-store="{{item}}" bindtap="onStoreTap">
      <text class="mm-emoji">{{item.category === '火锅' ? '🍲' : item.category === '饮品' ? '🧋' : item.category === '影院' ? '🎬' : item.category === '甜品' ? '🍰' : item.category === '咖啡' ? '☕' : '🏬'}}</text>
    </view>
  </view>

  <view class="mm-legend">轻点节点可查看店铺 · 连线为规划路线</view>
</view>
