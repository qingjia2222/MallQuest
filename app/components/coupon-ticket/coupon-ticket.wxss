.ct {
  position: relative;
  display: flex; align-items: stretch;
  background: #fff; border-radius: 22rpx; overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  margin: 16rpx 0;
}
.ct-main {
  flex: 1; padding: 26rpx 30rpx;
  border-right: 2rpx dashed rgba(0,0,0,0.08);
  display: flex; flex-direction: column; justify-content: center;
}
.ct-title { font-size: 30rpx; font-weight: 700; color: #1F2937; }
.ct-scope { font-size: 23rpx; color: #9CA3AF; margin-top: 8rpx; }
.ct-value { font-size: 23rpx; color: #7C3AED; margin-top: 8rpx; }

.ct-notch {
  position: absolute; width: 24rpx; height: 24rpx; border-radius: 50%;
  background: var(--bg); left: calc(75% - 12rpx);
}
.ct-notch.top { top: -12rpx; }
.ct-notch.bottom { bottom: -12rpx; }

.ct-side {
  width: 110rpx; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--cp), #06B6D4);
  color: #fff; font-size: 40rpx; font-weight: 800;
}
.ct-side.claimed { background: #e5e7eb; color: #10B981; font-size: 34rpx; }
.ct-side:active { transform: scale(0.95); }
