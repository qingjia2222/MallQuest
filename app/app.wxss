page{background:#F4F6FB;color:#1F2340;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif}.page{padding:28rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 12rpx 36rpx rgba(76,29,149,.08)}.title{font-size:40rpx;font-weight:700}.muted{color:#6B7280}.button{background:#7C3AED;color:#fff;border-radius:18rpx;margin-top:18rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{font-size:26rpx;border:1rpx solid #C4B5FD;padding:12rpx 20rpx;border-radius:99rpx;color:#6D28D9}.result{white-space:pre-wrap;font-size:24rpx;background:#111827;color:#D1FAE5;padding:20rpx;border-radius:18rpx;max-height:520rpx;overflow:auto}
