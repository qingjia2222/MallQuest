.map-page { min-height: 100vh; background: var(--bg); padding: 24rpx 28rpx 120rpx; }
.map-title-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.mt-name { font-size: 38rpx; font-weight: 800; }
.mt-sub { font-size: 24rpx; color: #9CA3AF; margin-top: 4rpx; }
.mt-btn { background: linear-gradient(135deg, #7C3AED, #06B6D4); color: #fff; font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 40rpx; font-weight: 600; }

.parking-card { display: flex; align-items: center; gap: 30rpx; }
.parking-info { flex: 1; }
.p-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.p-areas { display: flex; flex-wrap: wrap; gap: 12rpx; }
.p-area { background: #f9fafb; border-radius: 12rpx; padding: 8rpx 14rpx; font-size: 22rpx; color: #6B7280; display: flex; gap: 8rpx; align-items: center; }
.p-free { color: #7C3AED; font-weight: 700; }

.detail-mask{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:99;display:flex;align-items:flex-end}.detail{box-sizing:border-box;width:100%;max-height:88vh;overflow-y:auto;background:#fff;border-radius:34rpx 34rpx 0 0;padding:28rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));animation:slideUp .3s ease}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: none; } }
.d-hero{height:190rpx;border-radius:24rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;margin-bottom:22rpx;background:linear-gradient(135deg,#F3E7FF,#D9CBF2)}.d-hero.food{background:linear-gradient(135deg,#FFD9C7,#FFB3A7)}.d-hero.drink{background:linear-gradient(135deg,#E4D6FF,#C9B6EE)}.d-hero.service{background:linear-gradient(135deg,#E4E8EF,#CBD3E0)}.d-hero.retail{background:linear-gradient(135deg,#C9D9FF,#A9BFF0)}.dh-emoji{font-size:70rpx}.dh-name{font-size:28rpx;font-weight:800;color:#3A3550}.d-head{display:flex;align-items:center;gap:16rpx}.d-emoji{width:76rpx;height:76rpx;border-radius:18rpx;background:#EDE9FE;display:flex;align-items:center;justify-content:center;font-size:38rpx}.d-main{flex:1;min-width:0}.d-name{display:block;font-size:32rpx;font-weight:800}.d-meta{display:flex;flex-wrap:wrap;gap:10rpx;align-items:center;color:#9CA3AF;font-size:21rpx;margin-top:5rpx}.d-badge{background:#EDE9FE;color:#7C3AED;padding:4rpx 12rpx;border-radius:18rpx;font-weight:700}.d-close{font-size:42rpx;color:#9CA3AF;padding:8rpx}.d-states{display:flex;gap:12rpx;margin:22rpx 0}.d-states view{flex:1;background:#F8FAFC;border-radius:18rpx;padding:15rpx;text-align:center}.d-states text{display:block}.d-states text:first-child{font-size:26rpx;font-weight:800;color:#6D28D9}.d-states text:last-child{font-size:20rpx;color:#9CA3AF;margin-top:4rpx}.d-desc{display:block;color:#6B7280;font-size:24rpx;line-height:1.6;margin-bottom:16rpx}.d-reco-title{display:block;color:#9CA3AF;font-size:22rpx;font-weight:700;margin-bottom:9rpx}.d-reco view{display:flex;flex-wrap:wrap;gap:9rpx;margin-bottom:16rpx}.d-reco view text{background:#F5F3FF;color:#7C3AED;border-radius:18rpx;padding:6rpx 15rpx;font-size:21rpx}.detail-ai{display:inline-flex;margin:4rpx 0 0;padding:0 18rpx!important;min-height:64rpx!important;line-height:64rpx!important;border:0;border-radius:32rpx;background:linear-gradient(135deg,#7C3AED,#06B6D4);color:#fff;font-size:23rpx}.d-reply{background:#F5F3FF;border-radius:18rpx;padding:18rpx;font-size:24rpx;line-height:1.55;margin-top:14rpx}.d-actions{display:flex;gap:16rpx;margin-top:20rpx}.d-actions button{flex:1;border-radius:36rpx;font-size:24rpx;line-height:2.5}.d-actions .ghost{background:#fff;color:#7C3AED;border:2rpx solid #E5E7EB}.d-actions .primary{background:linear-gradient(135deg,#7C3AED,#06B6D4);color:#fff}
.route-waypoints{display:flex;flex-wrap:wrap;gap:12rpx;padding:16rpx 22rpx;background:#fff}.route-waypoint{display:flex;align-items:center;gap:8rpx;padding:8rpx 14rpx;border-radius:28rpx;background:#ede9fe;color:#4c1d95;font-size:22rpx}.route-waypoint text{width:34rpx;height:34rpx;border-radius:50%;background:#7c3aed;color:#fff;text-align:center;line-height:34rpx;font-weight:700}
