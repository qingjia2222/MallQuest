.map-page { min-height: 100vh; background: var(--bg); padding: 24rpx 28rpx 120rpx; }
.map-title-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.mt-name { font-size: 38rpx; font-weight: 800; }
.mt-sub { font-size: 24rpx; color: #9CA3AF; margin-top: 4rpx; }
.mt-btn { background: linear-gradient(135deg, #7C3AED, #06B6D4); color: #fff; font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 40rpx; font-weight: 600; }

.parking-card { display: flex; align-items: center; gap: 30rpx; }
.parking-info { flex: 1; }
.p-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.p-areas { display: flex; flex-wrap: wrap; gap: 12rpx; }
.p-area { background: #f9fafb; border-radius: 12rpx; padding: 8rpx 14rpx; font-size: 22rpx; color: #6B7280; display: flex; gap: 8rpx; align-items: center; }
.p-free { color: #7C3AED; font-weight: 700; }

.detail-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 50;
  display: flex; align-items: flex-end;
}
.detail { width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 36rpx 36rpx 60rpx; animation: slideUp 0.3s ease; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: none; } }
.d-head { display: flex; align-items: center; gap: 18rpx; }
.d-emoji { width: 88rpx; height: 88rpx; border-radius: 22rpx; background: #ede9fe; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.d-main { flex: 1; display: flex; flex-direction: column; }
.d-name { font-size: 34rpx; font-weight: 700; }
.d-meta { font-size: 24rpx; color: #9CA3AF; margin-top: 4rpx; }
.d-close { font-size: 44rpx; color: #9CA3AF; padding: 0 10rpx; }
.d-desc { display: block; font-size: 28rpx; color: #1F2937; margin: 24rpx 0 8rpx; }
.d-wait { font-size: 26rpx; color: #F59E0B; margin-bottom: 24rpx; }
.d-live { display: flex; justify-content: space-between; gap: 10rpx; font-size: 22rpx; color: #6B7280; margin: 18rpx 0; }
.d-deal { color: #C2410C; background: #FFF7ED; border-radius: 14rpx; padding: 16rpx; margin-bottom: 22rpx; }
.d-actions { display: flex; gap: 18rpx; }
.ic-btn { flex: 1; text-align: center; border-radius: 40rpx; padding: 20rpx 0; font-size: 28rpx; font-weight: 600; }
.ic-btn.ghost { background: #fff; color: #7C3AED; border: 2rpx solid var(--border); }
.ic-btn.primary { background: linear-gradient(135deg, #7C3AED, #06B6D4); color: #fff; }
