<view class="map-page">
  <view class="mall-strip"><view class="mall-strip-logo">🛍️</view><view class="mall-strip-main"><text class="mall-strip-name">星河里 · 购物中心</text><text class="mall-strip-addr">上海市黄浦区南京东路 168 号</text></view></view>
  <view class="map-title-bar">
    <view>
      <view class="mt-name">规划</view>
      <view class="mt-sub">方案路线 · 店铺实时状态 · 预定情况</view>
    </view>
    <view class="mt-btn" bindtap="goPlan">帮我规划</view>
  </view>

  <mini-map stores="{{stores}}" route="{{route}}" routeNodes="{{routeNodes}}" activeId="{{activeId}}"
            bind:storetap="onStoreTap" />
  <view wx:if="{{waypoints.length}}" class="route-waypoints"><view wx:for="{{waypoints}}" wx:key="store_id" class="route-waypoint"><text>{{index + 1}}</text>{{item.name}} · {{item.floor}}F</view></view>

  <!-- 店铺详情弹层 -->
  <view wx:if="{{showDetail && focusStore}}" class="detail-mask" bindtap="closeDetail">
    <view class="detail" catchtap="noop">
      <view class="d-head">
        <view class="d-emoji">🏬</view>
        <view class="d-main">
          <text class="d-name">{{focusStore.name}}</text>
          <text class="d-meta">{{focusStore.category}} · {{focusStore.floor}}F · 编码 {{focusStore.store_code || '待分配'}}</text>
          <text class="d-meta">{{focusStore.business_hours}}</text>
        </view>
        <view class="d-close" bindtap="closeDetail">×</view>
      </view>
      <text class="d-desc">{{focusStore.desc}}</text>
      <view class="d-live"><text>营业：{{focusStore.open_status}}</text><text>预计排队：{{focusStore.waiting}} 分钟</text><text>可用座位：{{focusStore.seats_available}}</text></view>
      <view wx:if="{{focusStore.deal_title}}" class="d-deal">当前优惠：{{focusStore.deal_title}} · ¥{{focusStore.deal_price}}</view>
      <view class="d-actions">
        <view class="ic-btn ghost" bindtap="closeDetail">再看看</view>
        <view class="ic-btn primary" bindtap="reserve">去预约</view>
      </view>
    </view>
  </view>
</view>
