<view class="map-page">
  <view class="map-title-bar">
    <view>
      <view class="mt-name">室内导览地图</view>
      <view class="mt-sub">店铺状态由商户端实时同步</view>
    </view>
    <view class="mt-btn" bindtap="goPlan">帮我规划</view>
  </view>

  <mini-map stores="{{stores}}" route="{{route}}" activeId="{{activeId}}"
            bind:storetap="onStoreTap" />

  <!-- 停车位概览 -->
  <view class="parking-card card">
    <parking-gauge free="{{parking.total_free}}" total="{{parking.total}}" />
    <view class="parking-info">
      <view class="p-title">🚗 实时停车位</view>
      <view class="p-areas">
        <view wx:for="{{parking.areas}}" wx:key="id" class="p-area">
          <text>{{item.area}}</text><text class="p-free">{{item.free}} 空</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 店铺详情弹层 -->
  <view wx:if="{{showDetail && focusStore}}" class="detail-mask" bindtap="closeDetail">
    <view class="detail" catchtap="noop">
      <view class="d-head">
        <view class="d-emoji">🏬</view>
        <view class="d-main">
          <text class="d-name">{{focusStore.name}}</text>
          <text class="d-meta">{{focusStore.category}} · {{focusStore.floor}}F · {{focusStore.business_hours}}</text>
        </view>
        <view class="d-close" bindtap="closeDetail">×</view>
      </view>
      <text class="d-desc">{{focusStore.desc}}</text>
      <view class="d-live"><text>营业：{{focusStore.open_status}}</text><text>预计排队：{{focusStore.waiting}} 分钟</text><text>可用座位：{{focusStore.seats_available}}</text></view>
      <view wx:if="{{focusStore.deal_title}}" class="d-deal">当前优惠：{{focusStore.deal_title}} · ¥{{focusStore.deal_price}}</view>
      <view class="d-actions">
        <view class="ic-btn ghost" bindtap="closeDetail">再看看</view>
        <view class="ic-btn primary" bindtap="reserve">去预约</view>
      </view>
    </view>
  </view>
</view>
