<view class="home-page page">
  <view class="mall-strip"><view class="mall-strip-logo">🛍️</view><view class="mall-strip-main"><text class="mall-strip-name">星河里 · 购物中心</text><text class="mall-strip-addr">上海市黄浦区南京东路 168 号</text></view></view>
  <view class="home-title">星河里 · 购物中心</view>
  <view class="home-sub">点击店铺查看实时状态 · 规划后在「规划」页看路线</view>
  <mini-map stores="{{stores}}" facilities="{{facilities}}" route="{{route}}" routeNodes="{{routeNodes}}" activeId="{{activeId}}" bind:storetap="onStoreTap" />
  <view class="parking-card card"><parking-gauge free="{{parking.total_free}}" total="{{parking.total}}" /><view class="parking-info"><view class="p-title">实时停车位</view><view class="p-areas"><text wx:for="{{parking.areas}}" wx:key="area">{{item.area}} {{item.free}}/{{item.total}}</text></view></view></view>
  <view class="store-head"><text>店铺一览</text><text>{{filteredStores.length}} 家</text></view>
  <view class="filter-bar">
    <view class="filter-row"><text>按</text><picker range="{{filterByLabels}}" value="{{filterByIndex}}" bindchange="onFilterBy"><view class="filter-picker">{{filterByLabels[filterByIndex]}}⌄</view></picker></view>
    <view class="filter-row"><text>分类</text><picker range="{{filterOptions}}" value="{{filterIndex}}" bindchange="onFilterValue"><view class="filter-picker">{{filterOptions[filterIndex]}}⌄</view></picker></view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view class="store-grid">
    <view wx:for="{{filteredStores}}" wx:key="id" class="store-card" data-store="{{item}}" bindtap="onStoreTap">
      <view class="store-icon">{{item.category === '咖啡' ? '☕' : item.category === '甜品' ? '🍰' : item.category === '影院' ? '🎬' : '🏬'}}</view>
      <view class="store-main"><text class="store-name">{{item.name}}</text><text class="store-meta">{{item.category}} · {{item.floor}}F</text><view class="store-tags"><text class="wait">排 {{item.waiting}} 分钟</text><text>余 {{item.seats_available}}</text><text class="open">营业中</text></view></view>
    </view>
  </view>
  <view wx:if="{{showDetail && focusStore}}" class="detail-mask" bindtap="closeDetail"><view class="detail" catchtap="noop">
    <view class="d-hero {{focusStore.heroClass}}"><text class="dh-emoji">{{focusStore.hero || focusStore.emoji}}</text><text class="dh-name">{{focusStore.name}}</text></view>
    <view class="d-head"><view class="d-emoji">{{focusStore.emoji}}</view><view class="d-main"><text class="d-name">{{focusStore.name}}</text><view class="d-meta"><text class="d-badge">{{focusStore.category}}</text><text>{{focusStore.floor}}F · 编码 {{focusStore.store_code || '待分配'}}{{focusStore.avg_price ? ' · ¥' + focusStore.avg_price + '/人' : ''}}</text></view></view><view class="d-close" bindtap="closeDetail">×</view></view>
    <view class="d-states"><view><text>{{focusStore.queueText}}</text><text>排队</text></view><view><text>{{focusStore.seats_available}}</text><text>余位</text></view><view><text>{{focusStore.statusText}}</text><text>营业</text></view></view>
    <text wx:if="{{focusStore.desc}}" class="d-desc">{{focusStore.desc}}</text>
    <view wx:if="{{focusStore.recommend && focusStore.recommend.length}}" class="d-reco"><text class="d-reco-title">🍽️ 推荐</text><view><text wx:for="{{focusStore.recommend}}" wx:key="*this">{{item}}</text></view></view>
    <button class="detail-ai" loading="{{asking}}" disabled="{{asking}}" bindtap="askAI">{{asking ? '查询中…' : '🤖 问问 AI 这家店'}}</button>
    <view wx:if="{{aiReply}}" class="d-reply">{{aiReply}}</view>
    <view class="d-actions"><button class="ghost" bindtap="closeDetail">关闭</button><button class="reserve" disabled="{{!focusStore.reservable}}" bindtap="goReserve">{{focusStore.reservable ? '📅 预约' : '暂不可预约'}}</button><button class="primary" bindtap="goNavigate">🧭 导航到此店铺</button></view>
  </view></view>
</view>
