.home-page { padding-bottom: 130rpx; }
.home-title { font-size: 40rpx; font-weight: 800; margin-top: 8rpx; }.home-sub { color:#9CA3AF;font-size:24rpx;margin:4rpx 0 22rpx; }
.store-head { display:flex;justify-content:space-between;align-items:center;font-size:32rpx;font-weight:800;margin:26rpx 0 16rpx; }.store-head text:last-child{font-size:23rpx;color:#9CA3AF;font-weight:400}
.filter-bar{margin-bottom:18rpx;padding:18rpx 20rpx;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 22rpx rgba(124,58,237,.06)}.filter-row{display:flex;align-items:center;gap:16rpx;margin-bottom:12rpx}.filter-row:last-child{margin-bottom:0}.filter-row>text{width:54rpx;flex-shrink:0;color:#9CA3AF;font-size:23rpx}.filter-row picker{flex:1}.filter-picker{box-sizing:border-box;width:100%;padding:16rpx 20rpx;border:2rpx solid #E5E7EB;border-radius:16rpx;background:#fff;color:#111827;font-size:25rpx}
.store-grid { display:grid;grid-template-columns:1fr 1fr;gap:16rpx; }.store-card{background:#fff;border-radius:24rpx;padding:22rpx;display:flex;gap:16rpx;min-width:0;box-shadow:0 8rpx 26rpx rgba(124,58,237,.06)}
.store-icon{width:68rpx;height:68rpx;flex-shrink:0;border-radius:18rpx;background:#F1EAFE;display:flex;align-items:center;justify-content:center;font-size:34rpx}.store-main{flex:1;min-width:0;display:flex;flex-direction:column}.store-name{font-size:27rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.store-meta{font-size:21rpx;color:#6B7280;margin-top:3rpx}.store-tags{display:flex;flex-wrap:wrap;gap:7rpx;margin-top:10rpx}.store-tags text{font-size:19rpx;background:#F8FAFC;color:#64748B;padding:3rpx 8rpx;border-radius:14rpx}.store-tags .wait{color:#D97706;background:#FFFBEB}.store-tags .open{color:#059669;background:#ECFDF5}.empty{text-align:center;color:#9CA3AF;padding:40rpx}
.detail-mask{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:99;display:flex;align-items:flex-end}.detail{box-sizing:border-box;width:100%;max-height:88vh;overflow-y:auto;background:#fff;border-radius:34rpx 34rpx 0 0;padding:28rpx 28rpx calc(42rpx + env(safe-area-inset-bottom))}.d-hero{height:190rpx;border-radius:24rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;margin-bottom:22rpx;background:linear-gradient(135deg,#F3E7FF,#D9CBF2)}.d-hero.food{background:linear-gradient(135deg,#FFD9C7,#FFB3A7)}.d-hero.drink{background:linear-gradient(135deg,#E4D6FF,#C9B6EE)}.d-hero.service{background:linear-gradient(135deg,#E4E8EF,#CBD3E0)}.d-hero.retail{background:linear-gradient(135deg,#C9D9FF,#A9BFF0)}.dh-emoji{font-size:70rpx}.dh-name{font-size:28rpx;font-weight:800;color:#3A3550}.d-head{display:flex;align-items:center;gap:16rpx}.d-emoji{width:76rpx;height:76rpx;border-radius:18rpx;background:#EDE9FE;display:flex;align-items:center;justify-content:center;font-size:38rpx}.d-main{flex:1;min-width:0}.d-name{display:block;font-size:32rpx;font-weight:800}.d-meta{display:flex;flex-wrap:wrap;gap:10rpx;align-items:center;color:#9CA3AF;font-size:21rpx;margin-top:5rpx}.d-badge{background:#EDE9FE;color:#7C3AED;padding:4rpx 12rpx;border-radius:18rpx;font-weight:700}.d-close{font-size:42rpx;color:#9CA3AF;padding:8rpx}.d-states{display:flex;gap:12rpx;margin:22rpx 0}.d-states view{flex:1;background:#F8FAFC;border-radius:18rpx;padding:15rpx;text-align:center}.d-states text{display:block}.d-states text:first-child{font-size:26rpx;font-weight:800;color:#6D28D9}.d-states text:last-child{font-size:20rpx;color:#9CA3AF;margin-top:4rpx}.d-desc{display:block;color:#6B7280;font-size:24rpx;line-height:1.6;margin-bottom:16rpx}.d-reco-title{display:block;color:#9CA3AF;font-size:22rpx;font-weight:700;margin-bottom:9rpx}.d-reco view{display:flex;flex-wrap:wrap;gap:9rpx;margin-bottom:16rpx}.d-reco view text{background:#F5F3FF;color:#7C3AED;border-radius:18rpx;padding:6rpx 15rpx;font-size:21rpx}.detail-ai{display:inline-flex;margin:4rpx 0 0;padding:0 18rpx!important;min-height:64rpx!important;line-height:64rpx!important;border:0;border-radius:32rpx;background:linear-gradient(135deg,#7C3AED,#06B6D4);color:#fff;font-size:23rpx}.d-reply{background:#F5F3FF;border-radius:18rpx;padding:18rpx;font-size:24rpx;line-height:1.55;margin-top:14rpx}.d-actions{display:flex;gap:16rpx;margin-top:20rpx}.d-actions button{flex:1;border-radius:36rpx;font-size:24rpx;line-height:2.5}.d-actions .ghost{background:#fff;color:#7C3AED;border:2rpx solid #E5E7EB}.d-actions .reserve{background:#F5F3FF;color:#7C3AED;border:2rpx solid #DDD6FE}.d-actions .reserve[disabled]{opacity:.55;color:#7C3AED}.d-actions .primary{background:linear-gradient(135deg,#7C3AED,#06B6D4);color:#fff}
