.portal{min-height:100vh;padding:42rpx 28rpx;background:linear-gradient(180deg,#2E1065 0,#5B21B6 34%,#F4F6FB 34%);box-sizing:border-box}.hero{color:#fff;padding:24rpx 14rpx 48rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#DDD6FE}.hero-title{font-size:52rpx;font-weight:750;margin:18rpx 0}.hero-copy{font-size:27rpx;line-height:1.65;color:#EDE9FE}.role-card{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:26rpx;padding:28rpx;margin-bottom:20rpx;box-shadow:0 16rpx 40rpx rgba(46,16,101,.13)}.role-icon{width:78rpx;height:78rpx;line-height:78rpx;text-align:center;border-radius:22rpx;font-size:34rpx;font-weight:700}.visitor .role-icon{background:#EDE9FE;color:#6D28D9}.merchant .role-icon{background:#ECFDF5;color:#047857}.manager .role-icon{background:#EFF6FF;color:#1D4ED8}.role-main{flex:1}.role-title{font-size:34rpx;font-weight:700;color:#1F2340}.role-copy{font-size:24rpx;color:#6B7280;line-height:1.55;margin-top:8rpx}.arrow{font-size:52rpx;color:#9CA3AF}.demo-note{text-align:center;color:#9CA3AF;font-size:22rpx;margin-top:32rpx}
