.portal{min-height:100vh;background:#f4f6fb;box-sizing:border-box;padding-bottom:54rpx}.hero{box-sizing:border-box;min-height:350rpx;padding:64rpx 42rpx 84rpx;color:#fff;background:linear-gradient(145deg,#35106f 0%,#6d28d9 100%);border-radius:0 0 44rpx 44rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#ddd6fe}.hero-title{font-size:52rpx;font-weight:750;margin:22rpx 0 14rpx}.hero-copy{font-size:27rpx;line-height:1.65;color:#ede9fe}.role-list{position:relative;margin:-48rpx 28rpx 0;padding:12rpx;border-radius:34rpx;background:rgba(255,255,255,.72);box-shadow:0 20rpx 55rpx rgba(46,16,101,.12);backdrop-filter:blur(16rpx)}.role-card{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:24rpx;padding:27rpx 24rpx;margin-bottom:12rpx;box-shadow:0 8rpx 24rpx rgba(31,35,64,.07)}.role-card:last-child{margin-bottom:0}.role-icon{width:78rpx;height:78rpx;line-height:78rpx;text-align:center;border-radius:22rpx;font-size:34rpx;font-weight:700;flex-shrink:0}.visitor .role-icon{background:#ede9fe;color:#6d28d9}.merchant .role-icon{background:#ecfdf5;color:#047857}.manager .role-icon{background:#eff6ff;color:#1d4ed8}.role-main{flex:1;min-width:0}.role-title{font-size:34rpx;font-weight:700;color:#1f2340}.role-copy{font-size:24rpx;color:#6b7280;line-height:1.5;margin-top:7rpx}.arrow{font-size:50rpx;color:#9ca3af}.demo-note{text-align:center;color:#9ca3af;font-size:22rpx;margin-top:34rpx}
