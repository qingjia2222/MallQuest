<view class="pf-page">
  <view class="mall-strip"><view class="mall-strip-logo">🛍️</view><view class="mall-strip-main"><text class="mall-strip-name">星河里 · 购物中心</text><text class="mall-strip-addr">上海市黄浦区南京东路 168 号</text></view></view>
  <!-- 头部 -->
  <view class="pf-hero">
    <view class="pf-avatar">🦸</view>
    <view class="pf-info">
      <text class="pf-name">{{user.nickname}}</text>
      <text class="pf-level">{{user.level}}</text>
    </view>
  </view>

  <!-- 积分能量条 -->
  <view class="pf-card card">
    <view class="pf-points-head">
      <text>我的积分</text>
      <text class="pf-points-num">{{user.points}}</text>
    </view>
    <view class="pf-bar"><view class="pf-bar-inner" style="width:{{user.points / user.nextLevelPoints * 100}}%"></view></view>
    <text class="pf-next">积分有效期至 {{user.expires_on}}</text>
  </view>

  <!-- 我的资产 -->
  <view class="pf-assets">
    <view class="pa" bindtap="goCoupon"><text class="pa-num">{{myCoupons}}</text><text class="pa-label">优惠券</text></view>
    <view class="pa" bindtap="goReserve"><text class="pa-num">{{myReservations}}</text><text class="pa-label">预约</text></view>
    <view class="pa"><text class="pa-num">0</text><text class="pa-label">待评价</text></view>
  </view>

  <view class="section-title">💡 试试对我说</view>
  <view class="chip-wrap">
    <view class="chip active" bindtap="goChatWith" data-text="帮我规划约会">帮我规划约会</view>
    <view class="chip" bindtap="goChatWith" data-text="停车还有空位吗">停车还有空位吗</view>
    <view class="chip" bindtap="goChatWith" data-text="积分多久过期">积分多久过期</view>
    <view class="chip" bindtap="goChatWith" data-text="今日特惠">今日特惠</view>
  </view>

  <button class="pf-exit" bindtap="logout">退出游客 / 会员端</button>
</view>
