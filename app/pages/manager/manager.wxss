.login-card{margin-top:60rpx}.role-tag{display:inline-block;color:#1D4ED8;background:#DBEAFE;padding:8rpx 14rpx;border-radius:99rpx;font-size:22rpx;margin-bottom:16rpx}
input{background:#F9FAFB;border-radius:14rpx;padding:18rpx;margin-top:16rpx}
.login-input{display:block;width:100%;height:88rpx;line-height:88rpx;padding:0 24rpx!important;margin-top:22rpx;background:#F9FAFB;border:2rpx solid #E5E7EB;border-radius:18rpx;color:#111827;font-size:28rpx}
.input-placeholder{color:#9CA3AF}.demo-hint{margin:12rpx 4rpx 0;color:#7C3AED;font-size:23rpx}
.dashboard-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;background:linear-gradient(135deg,#172554,#2563EB);color:#fff;border-radius:26rpx;padding:30rpx;margin-bottom:20rpx}.small{font-size:20rpx;letter-spacing:2rpx;color:#BFDBFE}.head-title{font-size:42rpx;font-weight:750;margin-top:8rpx}.head-actions{display:flex;flex-direction:column;align-items:stretch;gap:14rpx;flex-shrink:0}.exit,.grain{min-width:120rpx;text-align:center;background:#fff;color:#1E3A8A;padding:12rpx 18rpx;border-radius:28rpx;font-size:22rpx}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:20rpx}.kpi{background:#fff;border-radius:20rpx;padding:22rpx;display:flex;flex-direction:column;color:#6B7280}.kpi strong{color:#1E3A8A;font-size:34rpx;margin-top:8rpx}.section-title{font-size:31rpx;font-weight:700}.bar-row{display:grid;grid-template-columns:70rpx 1fr 105rpx;gap:10rpx;align-items:center;margin-top:16rpx;font-size:22rpx}.bar-track{height:18rpx;background:#EFF6FF;border-radius:99rpx;overflow:hidden}.bar{height:100%;background:linear-gradient(90deg,#60A5FA,#2563EB);border-radius:99rpx}
.period-note,.analytics-error{padding:18rpx 22rpx;margin-bottom:20rpx;border-radius:18rpx;background:#EFF6FF;color:#475569;font-size:23rpx}.period-note strong{color:#1D4ED8}.analytics-error{background:#FEF2F2;color:#DC2626}
.realtime{display:flex;justify-content:space-between;text-align:center}.realtime view{display:flex;flex-direction:column}.realtime strong{font-size:31rpx;color:#1D4ED8}.realtime text{font-size:21rpx;color:#6B7280;margin-top:7rpx}.created{margin-top:18rpx;padding:18rpx;background:#EFF6FF;border-radius:14rpx}.created strong{display:block;font-size:34rpx;color:#1D4ED8;margin:8rpx 0}
.card input{display:block;box-sizing:border-box;width:100%;height:92rpx;min-height:92rpx;line-height:92rpx;padding:0 22rpx;margin-top:18rpx;background:#F9FAFB;border:2rpx solid #EEF0F5;border-radius:16rpx;color:#111827;font-size:30rpx}
.login-card .login-input{height:92rpx;min-height:92rpx;line-height:92rpx;padding:0 24rpx!important}
.prompt-note{color:#6B7280;font-size:23rpx;line-height:1.55;margin-top:10rpx}.prompt-tabs{width:100%;white-space:nowrap;margin:20rpx 0 14rpx}.prompt-tabs-inner{display:inline-flex;gap:12rpx}.prompt-tab{padding:13rpx 20rpx;border:2rpx solid #DBE3F0;border-radius:30rpx;color:#475569;font-size:22rpx;background:#fff}.prompt-tab.active{color:#fff;background:#1D4ED8;border-color:#1D4ED8}.prompt-editor{box-sizing:border-box;width:100%;height:560rpx;min-height:560rpx;padding:22rpx;border:2rpx solid #DBE3F0;border-radius:18rpx;background:#F8FAFC;color:#172554;font-size:24rpx;line-height:1.6;font-family:monospace}.prompt-version{color:#64748B;font-size:21rpx;margin-top:12rpx;word-break:break-all}.prompt-message{color:#059669;font-size:22rpx;margin-top:10rpx}.prompt-actions{display:flex;gap:14rpx;margin-top:18rpx}.prompt-actions button{flex:1;margin:0;border-radius:36rpx;background:#fff;color:#1D4ED8;border:2rpx solid #DBE3F0;font-size:24rpx}.prompt-actions .prompt-save{color:#fff;border:0;background:linear-gradient(135deg,#7C3AED,#06B6D4)}
