.login-card{margin-top:60rpx}.role-tag{display:inline-block;color:#1D4ED8;background:#DBEAFE;padding:8rpx 14rpx;border-radius:99rpx;font-size:22rpx;margin-bottom:16rpx}input{background:#F9FAFB;border-radius:14rpx;padding:18rpx;margin-top:16rpx}.dashboard-head{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#172554,#2563EB);color:#fff;border-radius:26rpx;padding:30rpx;margin-bottom:20rpx}.small{font-size:20rpx;letter-spacing:2rpx;color:#BFDBFE}.head-title{font-size:42rpx;font-weight:750;margin-top:8rpx}.exit{font-size:22rpx;color:#BFDBFE;margin-top:12rpx}.grain{background:rgba(255,255,255,.16);padding:12rpx 18rpx;border-radius:14rpx}.kpis{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:20rpx}.kpi{background:#fff;border-radius:20rpx;padding:22rpx;display:flex;flex-direction:column;color:#6B7280}.kpi strong{color:#1E3A8A;font-size:34rpx;margin-top:8rpx}.section-title{font-size:31rpx;font-weight:700}.mock{font-size:18rpx;color:#D97706;background:#FEF3C7;padding:5rpx 9rpx;border-radius:8rpx}.bar-row{display:grid;grid-template-columns:70rpx 1fr 105rpx;gap:10rpx;align-items:center;margin-top:16rpx;font-size:22rpx}.bar-track{height:18rpx;background:#EFF6FF;border-radius:99rpx;overflow:hidden}.bar{height:100%;background:linear-gradient(90deg,#60A5FA,#2563EB);border-radius:99rpx}.realtime{display:flex;justify-content:space-between;text-align:center}.realtime view{display:flex;flex-direction:column}.realtime strong{font-size:31rpx;color:#1D4ED8}.realtime text{font-size:21rpx;color:#6B7280;margin-top:7rpx}.created{margin-top:18rpx;padding:18rpx;background:#EFF6FF;border-radius:14rpx}.created strong{display:block;font-size:34rpx;color:#1D4ED8;margin:8rpx 0}
