<view class="page"><view class="card"><view class="title">QD square AI</view><view class="muted">私有数据 · 多步规划 · 写操作确认</view><view class="chips"><view class="chip" data-text="停车场还有空位吗？" bindtap="quick">停车</view><view class="chip" data-text="积分多久过期？" bindtap="quick">积分规则</view><view class="chip" data-text="今天有什么特惠？" bindtap="quick">特惠</view></view></view><view class="card"><textarea value="{{input}}" bindinput="input" placeholder="说出目标或问题"/><button class="button" bindtap="send">发送</button><button wx:if="{{canConfirm}}" class="button" bindtap="confirm">确认方案并执行</button><button wx:if="{{reply}}" bindtap="speak">播报</button></view><view class="card"><view>{{reply}}</view><scroll-view scroll-y class="result">{{result}}</scroll-view></view></view>
