<view class="chat-page">
  <!-- 消息列表 -->
  <scroll-view class="chat-scroll" scroll-y id="chat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="msg-list">
      <block wx:for="{{messages}}" wx:key="index">
        <!-- 用户消息 -->
        <view wx:if="{{item.role === 'user'}}" class="bubble-row user">
          <view class="bubble user-bubble">{{item.text}}</view>
        </view>
        <!-- AI 消息 -->
        <view wx:else class="bubble-row ai">
          <view class="ai-avatar">AI</view>
          <view class="ai-body">
            <view class="bubble ai-bubble">{{item.text}}<text wx:if="{{!item.done && !item.card}}" class="caret"></text></view>
            <!-- 富卡片 -->
            <rich-card wx:if="{{item.card}}" card="{{item.card}}" bind:cardtap="onCardTap" />
            <!-- 方案提示 -->
            <view wx:if="{{item.plan}}" class="plan-hint" bindtap="onPlanTap">📋 已生成方案，查看详情 →</view>
            <!-- 规划入口 -->
            <view wx:if="{{item.quick && item.quick.length}}" class="quick-chips">
              <view wx:for="{{item.quick}}" wx:key="index" class="chip active" bindtap="send" data-text="{{item}}">{{item}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="composer">
    <view class="composer-input">
      <input placeholder="说点什么，或告诉我你的目标…" value="{{input}}" bindinput="onInput" bindconfirm="send" confirm-type="send" />
    </view>
    <view class="voice-btn"><voice-input bind:voice="onVoice" /></view>
    <view class="send-btn" bindtap="send" data-text="{{input}}">发送</view>
  </view>
  <view class="safe-bottom"></view>

  <view wx:if="{{navVisible}}" class="nav-mask">
    <view class="nav-modal">
      <view class="nav-head"><view><view class="nav-kicker">3D ROUTE · 自动导览</view><view class="nav-title">前往 {{navigation.destination_store.name}}</view></view><view class="nav-close" bindtap="closeNavigation">×</view></view>
      <view class="nav-stage"><image src="{{navMapUrl}}" mode="widthFix"/><canvas canvas-id="navCanvas" class="nav-canvas"/><view class="floor-badge">{{navFloor}}F</view><view class="you-badge">红点 = 您当前所在位置</view></view>
      <view class="nav-meta"><text>约 {{navigation.estimated_distance}}</text><text wx:if="{{navigation.transfer_instructions.length}}"> · 换乘 {{navigation.transfer_instructions.length}} 次</text></view>
      <view class="nav-actions"><button class="nav-replay" bindtap="replayNavigation">↻ 重播路线</button><button class="nav-done" bindtap="closeNavigation">关闭导览</button></view>
    </view>
  </view>
</view>
