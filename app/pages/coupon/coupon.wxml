<view class="cp-page">
  <view class="cp-hero">
    <text class="cp-hero-t">今日特惠</text>
    <text class="cp-hero-s">会员专属 · 先领券再下单</text>
  </view>

  <!-- 限时特惠 -->
  <view class="section-title">🔥 限时抢购</view>
  <view wx:for="{{deals}}" wx:key="id" class="deal card">
    <view class="deal-info">
      <text class="deal-t">{{item.title}}</text>
      <text class="deal-tag">{{item.tag}}</text>
      <view class="deal-price">
        <text class="dp-cur">¥{{item.price}}</text>
        <text class="dp-old">¥{{item.original}}</text>
        <text class="dp-stock">剩 {{item.stock}} 份</text>
      </view>
    </view>
    <view class="deal-buy" bindtap="buyDeal" data-id="{{item.id}}">{{item.purchased_quantity ? '再抢' : '抢'}}</view>
  </view>

  <!-- 优惠券 -->
  <view class="section-title">🎫 优惠券</view>
  <coupon-ticket wx:for="{{coupons}}" wx:key="id" coupon="{{item}}" claimed="{{item.claimed}}" bind:claim="claim" />
</view>
