.cp-page { min-height: 100vh; background: var(--bg); padding: 0 28rpx 120rpx; }
.cp-hero {
  margin: 0 -28rpx; padding: 50rpx 36rpx 44rpx;
  background: linear-gradient(160deg, #1b1530, #312158 60%, #4c3a8c);
  color: #fff;
}
.cp-hero-t { font-size: 44rpx; font-weight: 800; display: block; }
.cp-hero-s { font-size: 24rpx; color: rgba(255,255,255,0.75); margin-top: 8rpx; display: block; }

.deal { display: flex; align-items: center; }
.deal-info { flex: 1; display: flex; flex-direction: column; }
.deal-t { font-size: 30rpx; font-weight: 700; }
.deal-tag { align-self: flex-start; font-size: 20rpx; color: #7C3AED; background: #ede9fe; padding: 4rpx 16rpx; border-radius: 20rpx; margin: 8rpx 0; }
.deal-price { display: flex; align-items: baseline; gap: 12rpx; margin-top: 4rpx; }
.dp-cur { font-size: 36rpx; font-weight: 800; color: #EF4444; }
.dp-old { font-size: 24rpx; color: #9CA3AF; text-decoration: line-through; }
.dp-stock { font-size: 22rpx; color: #9CA3AF; }
.deal-buy {
  width: 92rpx; height: 92rpx; border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #06B6D4); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(124,58,237,0.3);
}
.deal-buy:active { transform: scale(0.92); }
