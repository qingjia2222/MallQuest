.login-card{margin-top:80rpx}.role-tag{display:inline-block;color:#047857;background:#D1FAE5;padding:8rpx 14rpx;border-radius:99rpx;font-size:22rpx;margin-bottom:16rpx}.role-tag.light{color:#D1FAE5;background:rgba(255,255,255,.15)}.hero-line{display:flex;justify-content:space-between;align-items:center}input,.picker{background:#F9FAFB;border-radius:14rpx;padding:18rpx;margin-top:16rpx}.store-hero{background:linear-gradient(135deg,#064E3B,#059669);color:#fff;border-radius:26rpx;padding:32rpx;margin-bottom:22rpx}.store-name{font-size:44rpx;font-weight:750;margin:16rpx 0 8rpx}.manager{margin-top:24rpx;color:#D1FAE5}.section-title{font-size:32rpx;font-weight:700}.form-row{display:flex;gap:16rpx}.form-row>view,.form-row>input{flex:1;min-width:0}.deal{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #EEF0F5;font-size:25rpx}
