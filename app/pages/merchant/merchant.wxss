.login-card{margin-top:80rpx}
.role-tag{display:inline-block;color:#047857;background:#D1FAE5;padding:8rpx 14rpx;border-radius:99rpx;font-size:22rpx;margin-bottom:16rpx}
.role-tag.light{color:#D1FAE5;background:rgba(255,255,255,.15)}
.hero-line{display:flex;justify-content:space-between;align-items:center}
input,.picker{background:#F9FAFB;border-radius:14rpx;padding:18rpx;margin-top:16rpx}
.login-input{display:block;width:100%;height:88rpx;line-height:88rpx;padding:0 24rpx!important;margin-top:22rpx;background:#F9FAFB;border:2rpx solid #E5E7EB;border-radius:18rpx;color:#111827;font-size:28rpx}
.input-placeholder{color:#9CA3AF}.demo-hint{margin:12rpx 4rpx 0;color:#7C3AED;font-size:23rpx}
.auth-switch{display:flex;gap:8rpx;padding:7rpx;margin-top:22rpx;background:#F3F4F6;border-radius:18rpx}.auth-option{flex:1;padding:16rpx;text-align:center;border-radius:13rpx;color:#6B7280;font-size:26rpx}.auth-option.active{background:#fff;color:#7C3AED;font-weight:700;box-shadow:0 4rpx 14rpx rgba(49,46,129,.1)}
.store-hero{background:linear-gradient(135deg,#064E3B,#059669);color:#fff;border-radius:26rpx;padding:32rpx;margin-bottom:22rpx}
.store-name{font-size:44rpx;font-weight:750;margin:16rpx 0 8rpx}.manager{margin-top:24rpx;color:#D1FAE5}
.section-title{font-size:32rpx;font-weight:700}.form-row{display:flex;gap:16rpx}.form-row>view,.form-row>input{flex:1;min-width:0}
.offer-tabs{display:flex;gap:12rpx;margin-top:20rpx;padding:6rpx;background:#F3F4F6;border-radius:18rpx}.offer-tab{flex:1;padding:18rpx 10rpx;text-align:center;border-radius:14rpx;color:#6B7280;font-size:26rpx}.offer-tab.active{color:#fff;background:linear-gradient(135deg,#7C3AED,#06B6D4);font-weight:700}
.deal{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #EEF0F5;font-size:25rpx}
.card input{display:block;box-sizing:border-box;width:100%;height:92rpx;min-height:92rpx;line-height:92rpx;padding:0 22rpx;margin-top:18rpx;background:#F9FAFB;border:2rpx solid #EEF0F5;border-radius:16rpx;color:#111827;font-size:30rpx}
.login-card .login-input{height:92rpx;min-height:92rpx;line-height:92rpx;padding:0 24rpx!important}
