.scan-page{width:100%;height:100vh;background:linear-gradient(160deg,#1b1530,#312158 62%,#4c3a8c);box-sizing:border-box}.login-shell{padding:92rpx 48rpx;color:#fff}.login-brand{font-size:21rpx;letter-spacing:5rpx;color:#c4b5fd}.login-title{font-size:52rpx;font-weight:750;margin:26rpx 0 14rpx}.login-copy{font-size:27rpx;line-height:1.65;color:#ddd6fe}.qr-state{margin:34rpx 0 30rpx;padding:18rpx 22rpx;border-radius:18rpx;background:rgba(16,185,129,.16);color:#a7f3d0;font-size:24rpx}.qr-state.manual{background:rgba(255,255,255,.09);color:#ddd6fe}.field-label{font-size:24rpx;color:#ddd6fe;margin:20rpx 4rpx 10rpx}.field{height:92rpx;padding:0 26rpx;border-radius:20rpx;background:#fff;color:#1f2937;font-size:30rpx}.login-button{margin-top:40rpx;border:0;border-radius:48rpx;background:linear-gradient(135deg,#8b5cf6,#06b6d4);color:#fff;font-size:30rpx;font-weight:700}.mock-tip{text-align:center;margin-top:22rpx;color:#c4b5fd;font-size:22rpx}.connection-card{position:absolute;left:44rpx;right:44rpx;bottom:150rpx;z-index:3;padding:24rpx;border-radius:22rpx;background:rgba(17,24,39,.78);color:#fff;text-align:center}.connection-title{font-size:28rpx;font-weight:700}.connection-source{font-size:21rpx;line-height:1.6;color:#d1fae5;margin-top:10rpx}.skip{position:absolute;bottom:64rpx;right:40rpx;z-index:4;color:#fff;font-size:26rpx;padding:12rpx 24rpx;border:2rpx solid rgba(255,255,255,.4);border-radius:40rpx}
