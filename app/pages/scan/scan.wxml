<view class="scan-page">
  <block wx:if="{{connecting}}">
    <particle-intro play="{{playing}}" text="{{connected ? '已连接 ' + mallName : '正在连接私有数据'}}" bind:done="onParticleDone" />
    <view class="connection-card" wx:if="{{connected}}">
      <view class="connection-title">AI 私域数据已就绪</view>
      <view class="connection-source">{{sourceText}}</view>
    </view>
    <view class="skip" wx:if="{{connected}}" bindtap="enterHome">进入 AI 助手 ›</view>
  </block>
  <view wx:else class="login-shell">
    <view class="login-brand">QD SQUARE · PRIVATE AI</view>
    <view class="login-title">游客 / 会员登录</view>
    <view class="login-copy">登录后连接当前商场的实时排队、停车、积分规则与今日特惠。</view>
    <view wx:if="{{qrDetected}}" class="qr-state">已识别 AI 服务二维码 · {{serviceCode}}</view>
    <view wx:else class="qr-state manual">普通入口 · 将连接 QD square Demo</view>
    <view class="field-label">手机号</view>
    <input class="field" type="number" maxlength="11" value="{{phone}}" data-key="phone" bindinput="field" placeholder="请输入手机号" />
    <view class="field-label">密码</view>
    <input class="field" password value="{{password}}" data-key="password" bindinput="field" placeholder="请输入密码" />
    <button class="login-button" bindtap="submitLogin">登录并连接商场</button>
    <view class="mock-tip">演示账号：11111111111　密码：123456</view>
  </view>
</view>
