<view class="plan-page">
  <!-- 顶部：目标 + 进度 -->
  <view class="plan-hero">
    <view class="plan-goal-chip">🎯 {{goalText}}</view>
    <plan-flow step="{{step}}" />
  </view>

  <!-- 步骤2：采集偏好 -->
  <view wx:if="{{step === 2}}" class="plan-body">
    <view class="q-label">第 {{qIndex + 1}} / {{questions.length}} 问</view>
    <view class="q-title">{{currentQ.label}}</view>
    <view class="q-options">
      <view wx:for="{{options}}" wx:key="index" class="q-opt" bindtap="pickOption" data-val="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 步骤3：生成中 -->
  <view wx:if="{{step === 3}}" class="plan-body">
    <view class="generating">
      <view class="gen-stars">
        <view class="star"></view><view class="star s2"></view><view class="star s3"></view>
      </view>
      <text class="gen-text">{{generating ? '正在为你规划路线…' : ''}}</text>
      <text class="gen-sub">结合店铺分布 · 实时状态 · 你的偏好</text>
    </view>
  </view>

  <!-- 步骤4-5：方案确认 / 执行 -->
  <view wx:if="{{step >= 4}}" class="plan-body">
    <view class="current-head">
      <view class="current-title">🎯 当前方案 <text class="current-state">{{step === 5 ? '已执行' : '待确认'}}</text></view>
      <view class="current-actions">
        <view wx:if="{{step === 4 && !editing}}" class="small-action" bindtap="startEdit">调整方案</view>
        <view class="small-action primary" bindtap="goMap">看路线</view>
      </view>
    </view>
    <itinerary-card wx:if="{{!editing}}" itinerary="{{itinerary}}" bind:stoptap="onStopTap"
                    bind:confirm="onConfirm" bind:change="onChangePlan" />
    <view wx:if="{{step === 4 && editing}}" class="plan-editor">
      <view class="editor-title">✏️ 编辑推荐方案（调整顺序与到店时间）</view>
      <view wx:for="{{plan.itinerary}}" wx:key="id" class="time-row">
        <view class="stop-index">{{index + 1}}</view><text class="stop-name">{{item.name}}</text>
        <input class="time-input" type="time" value="{{item.time_label}}" data-index="{{index}}" bindinput="editStopTime" />
        <button class="move-btn" size="mini" data-index="{{index}}" data-delta="-1" bindtap="moveStop">↑</button>
        <button class="move-btn" size="mini" data-index="{{index}}" data-delta="1" bindtap="moveStop">↓</button>
      </view>
      <view class="editor-buttons"><view class="editor-cancel" bindtap="cancelEdit">取消</view><button class="editor-save" loading="{{editSaving}}" disabled="{{editSaving}}" bindtap="savePlan">完成编辑</button></view>
    </view>
    <view wx:if="{{step === 5}}" class="done-tip">✅ 方案已执行，事务记录保持不变</view>
    <button wx:if="{{step === 5}}" bindtap="editExecutedPlan">复制为新方案并调整顺序 / 时间</button>
    <view class="plan-nav">
      <view class="ic-btn ghost" bindtap="goChat">返回对话</view>
      <view class="ic-btn primary" bindtap="goMap">查看地图路线</view>
    </view>
  </view>
</view>
