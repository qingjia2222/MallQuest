.plan-page { min-height: 100vh; background: var(--bg); }
.plan-hero {
  background: linear-gradient(160deg, #1b1530, #312158 60%, #4c3a8c);
  color: #fff; padding: 40rpx 36rpx 30rpx;
}
.plan-goal-chip {
  display: inline-flex; align-items: center; gap: 10rpx;
  background: rgba(255,255,255,0.14); border-radius: 40rpx;
  padding: 14rpx 28rpx; font-size: 28rpx; font-weight: 600; margin-bottom: 30rpx;
}
.plan-hero plan-flow { --primary: #a78bfa; }

.plan-body { padding: 24rpx 32rpx 120rpx; }

.q-label { font-size: 24rpx; color: #9CA3AF; margin-top: 40rpx; }
.q-title { font-size: 40rpx; font-weight: 700; margin: 16rpx 0 40rpx; }
.q-options { display: flex; flex-direction: column; gap: 20rpx; }
.q-opt {
  background: #fff; border-radius: 24rpx; padding: 30rpx 34rpx; font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(124,58,237,0.06); border: 2rpx solid transparent;
  display: flex; align-items: center;
}
.q-opt:active { border-color: #7C3AED; transform: scale(0.98); background: #f5f3ff; }

.generating { display: flex; flex-direction: column; align-items: center; margin-top: 120rpx; }
.gen-stars { display: flex; gap: 20rpx; }
.star {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #06B6D4);
  animation: genPulse 1s ease infinite;
}
.star.s2 { animation-delay: 0.2s; }
.star.s3 { animation-delay: 0.4s; }
@keyframes genPulse { 0%,100% { transform: scale(0.7); opacity: 0.5; } 50% { transform: scale(1.2); opacity: 1; } }
.gen-text { font-size: 34rpx; font-weight: 700; margin-top: 30rpx; }
.gen-sub { font-size: 24rpx; color: #9CA3AF; margin-top: 10rpx; }

.done-tip {
  text-align: center; font-size: 28rpx; color: #10B981; font-weight: 600; margin: 20rpx 0 10rpx;
}
.plan-nav { display: flex; gap: 18rpx; margin-top: 26rpx; }
.ic-btn { flex: 1; text-align: center; border-radius: 40rpx; padding: 20rpx 0; font-size: 28rpx; font-weight: 600; }
.ic-btn.ghost { background: #fff; color: #7C3AED; border: 2rpx solid var(--border); }
.ic-btn.primary { background: linear-gradient(135deg, #7C3AED, #06B6D4); color: #fff; }
.ic-btn:active { transform: scale(0.97); }
