.plan-page { min-height: 100vh; background: var(--bg); }
.plan-hero {
  background: linear-gradient(160deg, #1b1530, #312158 60%, #4c3a8c);
  color: #fff; padding: 40rpx 36rpx 30rpx;
}
.plan-goal-chip {
  display: inline-flex; align-items: center; gap: 10rpx;
  background: rgba(255,255,255,0.14); border-radius: 40rpx;
  padding: 14rpx 28rpx; font-size: 28rpx; font-weight: 600; margin-bottom: 30rpx;
}
.plan-hero plan-flow { --primary: #a78bfa; }

.plan-body { padding: 24rpx 32rpx 120rpx; }
.current-head { display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:0 0 18rpx;padding:4rpx 2rpx; }
.current-title { font-size:31rpx;font-weight:750;color:#111827; }
.current-state { margin-left:10rpx;padding:6rpx 14rpx;border-radius:22rpx;background:#FEF3C7;color:#D97706;font-size:20rpx;font-weight:600; }
.current-actions { display:flex;gap:10rpx;flex-shrink:0; }
.small-action { padding:12rpx 20rpx;border:1rpx solid #E5E7EB;border-radius:30rpx;background:#fff;color:#7C3AED;font-size:22rpx;font-weight:650; }
.small-action.primary { color:#fff;border:0;background:linear-gradient(135deg,#7C3AED,#06B6D4); }
.plan-editor { background:#fff;border-radius:28rpx;padding:26rpx 22rpx;box-shadow:0 10rpx 30rpx rgba(124,58,237,.08); }
.editor-title { font-size:27rpx;font-weight:700;margin-bottom:18rpx; }
.time-row { display:grid;grid-template-columns:44rpx minmax(0,1fr) 170rpx 58rpx 58rpx;align-items:center;gap:8rpx;padding:14rpx 8rpx;border-radius:16rpx;background:#F9FAFB;margin-top:10rpx; }
.stop-index { width:38rpx;height:38rpx;line-height:38rpx;text-align:center;border-radius:50%;background:#EDE9FE;color:#7C3AED;font-weight:700;font-size:22rpx; }
.stop-name { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:25rpx;font-weight:600; }
.time-input { height:64rpx;line-height:64rpx;padding:0 12rpx;border:1rpx solid #E5E7EB;border-radius:14rpx;background:#fff;font-size:24rpx; }
.move-btn { width:56rpx!important;min-width:56rpx!important;height:56rpx;line-height:52rpx;padding:0!important;margin:0!important;border:0;background:#fff;color:#7C3AED;font-size:27rpx; }
.move-btn::after,.editor-save::after { border:0; }
.editor-buttons { display:flex;gap:14rpx;margin-top:22rpx;align-items:center; }
.editor-cancel,.editor-save { flex:1;height:76rpx;line-height:76rpx;text-align:center;border-radius:38rpx;font-size:26rpx;font-weight:650;margin:0;padding:0; }
.editor-cancel { border:1rpx solid #E5E7EB;color:#6B7280;background:#fff; }
.editor-save { color:#fff;background:linear-gradient(135deg,#7C3AED,#06B6D4); }

.q-label { font-size: 24rpx; color: #9CA3AF; margin-top: 40rpx; }
.q-title { font-size: 40rpx; font-weight: 700; margin: 16rpx 0 40rpx; }
.q-options { display: flex; flex-direction: column; gap: 20rpx; }
.q-opt {
  background: #fff; border-radius: 24rpx; padding: 30rpx 34rpx; font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(124,58,237,0.06); border: 2rpx solid transparent;
  display: flex; align-items: center;
}
.q-opt:active { border-color: #7C3AED; transform: scale(0.98); background: #f5f3ff; }

.generating { display: flex; flex-direction: column; align-items: center; margin-top: 120rpx; }
.gen-stars { display: flex; gap: 20rpx; }
.star {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #06B6D4);
  animation: genPulse 1s ease infinite;
}
.star.s2 { animation-delay: 0.2s; }
.star.s3 { animation-delay: 0.4s; }
@keyframes genPulse { 0%,100% { transform: scale(0.7); opacity: 0.5; } 50% { transform: scale(1.2); opacity: 1; } }
.gen-text { font-size: 34rpx; font-weight: 700; margin-top: 30rpx; }
.gen-sub { font-size: 24rpx; color: #9CA3AF; margin-top: 10rpx; }

.done-tip {
  text-align: center; font-size: 28rpx; color: #10B981; font-weight: 600; margin: 20rpx 0 10rpx;
}
.plan-nav { display: flex; gap: 18rpx; margin-top: 26rpx; }
.ic-btn { flex: 1; text-align: center; border-radius: 40rpx; padding: 20rpx 0; font-size: 28rpx; font-weight: 600; }
.ic-btn.ghost { background: #fff; color: #7C3AED; border: 2rpx solid var(--border); }
.ic-btn.primary { background: linear-gradient(135deg, #7C3AED, #06B6D4); color: #fff; }
.ic-btn:active { transform: scale(0.97); }
